# Application Environment (development / production)
APP_ENV=development

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inventory

# Backend Database URLs (Leave blank for docker compose automatic generation)
# For local run outside docker, set to: postgresql://postgres:postgres@localhost:5432/inventory
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
